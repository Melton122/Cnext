// Self-hosting bootstrap: semver
// Port of src/semver.c

// Version constraint operators (mirrors VersionConstraint in include/semver.h)
const int COMP_EXACT = 0 // 1.2.3
const int COMP_CARET = 1 // ^1.2.3  (>=1.2.3 <2.0.0)
const int COMP_TILDE = 2 // ~1.2.3  (>=1.2.3 <1.3.0)
const int COMP_GTE   = 3 // >=1.2.3
const int COMP_GT    = 4 // >1.2.3
const int COMP_LTE   = 5 // <=1.2.3
const int COMP_LT    = 6 // <1.2.3
const int COMP_ANY   = 7 // * or ""

// Mirrors SemVer in include/semver.h. The fixed 64-byte prerelease/build
// buffers become dynamic strings; semver_parse still caps them at 63
// characters to match the C behaviour.
const int SEMVER_META_MAX = 63

class SemVer {
    int major
    int minor
    int patch
    str prerelease // e.g. "alpha.1", ""
    str build      // e.g. "build.123", ""

    func new() {
        self.major = 0
        self.minor = 0
        self.patch = 0
        self.prerelease = ""
        self.build = ""
    }
}

class VersionSpec {
    int op
    SemVer version

    func new() {
        self.op = COMP_EXACT
        self.version = new SemVer()
    }
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------
func semver_char_at(str s, int i): int {
    if i < 0 || i >= len(s) {
        return 0
    }
    return str_char_at(s, i)
}

func semver_is_digit(int ch): bool {
    return ch >= '0' && ch <= '9'
}

// ---------------------------------------------------------------------------
// Parsing
// ---------------------------------------------------------------------------
func semver_parse(SemVer out, str text): bool {
    out.major = 0
    out.minor = 0
    out.patch = 0
    out.prerelease = ""
    out.build = ""
    if text == null || len(text) == 0 {
        return false
    }

    int n = len(text)
    int p = 0
    int val = 0

    // major
    if !semver_is_digit(semver_char_at(text, p)) {
        return false
    }
    val = 0
    while p < n && semver_is_digit(str_char_at(text, p)) {
        val = val * 10 + (str_char_at(text, p) - '0')
        p = p + 1
    }
    out.major = val

    // minor
    if semver_char_at(text, p) == '.' {
        p = p + 1
    } else {
        return false
    }
    if !semver_is_digit(semver_char_at(text, p)) {
        return false
    }
    val = 0
    while p < n && semver_is_digit(str_char_at(text, p)) {
        val = val * 10 + (str_char_at(text, p) - '0')
        p = p + 1
    }
    out.minor = val

    // patch
    if semver_char_at(text, p) == '.' {
        p = p + 1
    } else {
        return false
    }
    if !semver_is_digit(semver_char_at(text, p)) {
        return false
    }
    val = 0
    while p < n && semver_is_digit(str_char_at(text, p)) {
        val = val * 10 + (str_char_at(text, p) - '0')
        p = p + 1
    }
    out.patch = val

    // prerelease (up to SEMVER_META_MAX chars, stops at '+' or end)
    if semver_char_at(text, p) == '-' {
        p = p + 1
        int i = 0
        while p < n && str_char_at(text, p) != '+' && i < SEMVER_META_MAX {
            out.prerelease = out.prerelease + str_substring(text, p, p + 1)
            p = p + 1
            i = i + 1
        }
    }

    // build (up to SEMVER_META_MAX chars, stops at end)
    if semver_char_at(text, p) == '+' {
        p = p + 1
        int i = 0
        while p < n && i < SEMVER_META_MAX {
            out.build = out.build + str_substring(text, p, p + 1)
            p = p + 1
            i = i + 1
        }
    }

    return true
}

func semver_parse_spec(VersionSpec out, str text): bool {
    out.op = COMP_EXACT
    out.version = new SemVer()
    if text == null || len(text) == 0 {
        out.op = COMP_ANY
        return true
    }

    int p = 0
    int op = COMP_EXACT
    int c0 = semver_char_at(text, 0)
    int c1 = semver_char_at(text, 1)

    if c0 == '^' && c1 != '=' {
        op = COMP_CARET
        p = 1
    } else if c0 == '~' && c1 != '=' {
        op = COMP_TILDE
        p = 1
    } else if c0 == '>' && c1 == '=' {
        op = COMP_GTE
        p = 2
    } else if c0 == '>' && c1 != '=' {
        op = COMP_GT
        p = 1
    } else if c0 == '<' && c1 == '=' {
        op = COMP_LTE
        p = 2
    } else if c0 == '<' && c1 != '=' {
        op = COMP_LT
        p = 1
    } else if c0 == '=' && c1 == '=' {
        op = COMP_EXACT
        p = 2
    } else if c0 == '*' {
        out.op = COMP_ANY
        return true
    }

    out.op = op
    return semver_parse(out.version, str_substring(text, p, len(text)))
}

// ---------------------------------------------------------------------------
// Comparison
// ---------------------------------------------------------------------------
func semver_compare(SemVer a, SemVer b): int {
    if a.major != b.major {
        return a.major - b.major
    }
    if a.minor != b.minor {
        return a.minor - b.minor
    }
    if a.patch != b.patch {
        return a.patch - b.patch
    }

    // prerelease versions have lower precedence
    bool a_pre = len(a.prerelease) > 0
    bool b_pre = len(b.prerelease) > 0
    if a_pre && !b_pre {
        return -1
    }
    if !a_pre && b_pre {
        return 1
    }
    if !a_pre && !b_pre {
        return 0
    }

    if a.prerelease < b.prerelease {
        return -1
    }
    if a.prerelease > b.prerelease {
        return 1
    }
    return 0
}

func semver_satisfies(SemVer version, VersionSpec spec): bool {
    if spec.op == COMP_ANY {
        return true
    }
    if spec.op == COMP_EXACT {
        return semver_compare(version, spec.version) == 0
    }
    if spec.op == COMP_GTE {
        return semver_compare(version, spec.version) >= 0
    }
    if spec.op == COMP_GT {
        return semver_compare(version, spec.version) > 0
    }
    if spec.op == COMP_LTE {
        return semver_compare(version, spec.version) <= 0
    }
    if spec.op == COMP_LT {
        return semver_compare(version, spec.version) < 0
    }
    if spec.op == COMP_CARET {
        if semver_compare(version, spec.version) < 0 {
            return false
        }
        // ^1.2.3 means >=1.2.3 <2.0.0
        // ^0.2.3 means >=0.2.3 <0.3.0
        // ^0.0.3 means >=0.0.3 <0.0.4
        if spec.version.major > 0 {
            return version.major == spec.version.major
        } else if spec.version.minor > 0 {
            return version.major == spec.version.major &&
                   version.minor == spec.version.minor
        } else {
            return version.major == spec.version.major &&
                   version.minor == spec.version.minor &&
                   version.patch == spec.version.patch
        }
    }
    if spec.op == COMP_TILDE {
        if semver_compare(version, spec.version) < 0 {
            return false
        }
        // ~1.2.3 means >=1.2.3 <1.3.0
        return version.major == spec.version.major &&
               version.minor == spec.version.minor
    }
    return false
}

// The C version formats into a caller-supplied buffer; the port returns the
// formatted string directly.
func semver_to_string(SemVer ver): str {
    // Note: string interpolation only resolves `{x.field}` through `->` for
    // *local* class variables (see track_class_var in codegen), so a class
    // parameter's fields are read into locals first.
    int maj = ver.major
    int mnr = ver.minor
    int pat = ver.patch
    str pre = ver.prerelease
    str bld = ver.build
    str base = "{maj}.{mnr}.{pat}"
    if len(pre) > 0 && len(bld) > 0 {
        return "{base}-{pre}+{bld}"
    }
    if len(pre) > 0 {
        return "{base}-{pre}"
    }
    if len(bld) > 0 {
        return "{base}+{bld}"
    }
    return base
}
