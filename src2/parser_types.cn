// Self-hosting bootstrap: AST node kind constants and the ASTNode/Token/Parser
// data-structure definitions used by all parser modules in src2/.
// Mirrors include/ast.h and include/parser_internal.h.

// ---------------------------------------------------------------------------
// AST node kind constants (values must match ASTNodeType enum in include/ast.h)
// ---------------------------------------------------------------------------
