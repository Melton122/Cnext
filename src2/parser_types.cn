// Kind-name table (index == AST_xxx constant, matches tools/astdump.c)
func ast_kind_name(int kind): str {
    str[] names = {
        "PROGRAM", "MAIN", "BLOCK", "VAR_DECL", "FUNC_DECL", "MACRO_DECL",
        "CLASS_DECL", "STRUCT_DECL", "ENUM_DECL", "EXPR_STMT", "IF", "WHILE",
        "FOR", "FOR_IN", "SWITCH", "CASE", "DEFAULT", "IMPORT", "RETURN",
        "ASSIGN", "BINARY", "UNARY", "POSTFIX", "CALL", "IDENTIFIER", "LITERAL",
        "LITERAL_ARRAY", "MEMBER_ACCESS", "INDEX", "SLICE", "BREAK", "CONTINUE",
        "TRY", "CATCH", "THROW", "INTERFACE_DECL", "TRAIT_DECL", "CONSTRUCTOR",
        "NEW_EXPR", "SUPER_EXPR", "TYPEOF", "MATCH", "MATCH_ARM", "LAMBDA",
        "CAST", "NULL_LITERAL", "TEST", "ASSERT", "TYPE_PARAM", "TUPLE",
        "TUPLE_ACCESS", "NAMED_ARG", "VARIADIC", "OPERATOR_DECL", "EXTEND_DECL",
        "DESTRUCTURE", "OPTION_SOME", "OPTION_NONE", "RESULT_OK", "RESULT_ERR",
        "NULL_COALESCE", "TERNARY", "SAFE_ACCESS", "YIELD", "COROUTINE_DECL",
        "RESUME_EXPR", "ASYNC_FUNC_DECL", "AWAIT_EXPR", "RUN_ASYNC", "ATTRIBUTE",
        "CONSTEXPR_DECL", "MACRO_INVOCATION", "GUARD", "EXTERN_DECL", "BENCH_DECL",
        "OWN_EXPR", "TYPE_ALIAS", "DEFER", "RANGE", "UNION_TYPE", "STATIC_METHOD",
        "ABSTRACT_METHOD", "VARIANT", "TRY_EXPR", "RANGE_INCLUSIVE", "WHEN",
        "WHEN_ARM"
    }
    if kind >= 0 && kind < len(names) {
        return names[kind]
    }
    return "UNKNOWN"
}

// ---------------------------------------------------------------------------
// Token — struct type passed by value in C.
// ---------------------------------------------------------------------------
struct Token {
    int kind      // TOKEN_xxx constant
    str text      // Source text of token
    int line
    int col
    int start_index // Offset of the token's first character in the source
}

func make_token(int k, str t, int ln, int c): Token {
    Token tok
    tok.kind = k
    tok.text = t
    tok.line = ln
    tok.col  = c
    tok.start_index = 0
    return tok
}

func make_eof_token(): Token {
    Token tok
    tok.kind = 0
    tok.text = ""
    tok.line = 1
    tok.col  = 1
    tok.start_index = 0
    return tok
}

// A token that carries nothing but its kind. The C parser sets `.type` on a
// zero-initialized token in a few places, which leaves the text and position
// empty; the AST dump prints that as var_type="".
func make_kind_token(int k): Token {
    return make_token(k, "", 0, 0)
}

// ---------------------------------------------------------------------------
// ASTNode — mirrors C ASTNode struct.
// ---------------------------------------------------------------------------
class ASTNode {
    int kind               // AST_xxx constant

    // Primary token
    Token token

    // Declared type
    Token var_type
    // Return type
    Token return_type
    // Resolved expression type
    int expr_type

    // Boolean flags
    bool is_const
    bool is_array
    bool is_pointer         // nullable (str?)
    bool is_class
    bool is_pointer_access
    bool is_union_type
    bool type_is_inferred
    bool is_variadic
    bool is_generator
    bool is_tail_call_optimized
    bool is_static
    bool is_abstract
    bool is_final

    // Metadata
    str type_name
    str parent_name
    str implements_names
    str attribute_name

    Token named_arg_name
    Token operator_token

    // Child lists
    ASTNode[] children
    ASTNode[] type_params
    ASTNode[] type_args

    // Structural slots
    ASTNode? left
    ASTNode? right
    ASTNode? condition
    ASTNode? init
    ASTNode? increment
    ASTNode? default_value

    func new(int k, Token tok) {
        self.kind           = k
        self.token          = tok
        self.var_type       = make_eof_token()
        self.return_type    = make_eof_token()
        self.expr_type      = 0
        self.is_const       = false
        self.is_array       = false
        self.is_pointer     = false
        self.is_class       = false
        self.is_pointer_access = false
        self.is_union_type  = false
        self.type_is_inferred = false
        self.is_variadic    = false
        self.is_generator   = false
        self.is_tail_call_optimized = false
        self.is_static      = false
        self.is_abstract    = false
        self.is_final       = false
        self.type_name      = ""
        self.parent_name    = ""
        self.implements_names = ""
        self.attribute_name = ""
        self.named_arg_name = make_eof_token()
        self.operator_token = make_eof_token()
        self.children       = {}
        self.type_params    = {}
        self.type_args      = {}
        self.left           = null
        self.right          = null
        self.condition      = null
        self.init           = null
        self.increment      = null
        self.default_value  = null
    }
}

func node_add_child(ASTNode parent, ASTNode child) {
    push(parent.children, child)
}

func node_add_type_param(ASTNode parent, ASTNode param) {
    push(parent.type_params, param)
}

func node_add_type_arg(ASTNode parent, ASTNode arg) {
    push(parent.type_args, arg)
}

// ---------------------------------------------------------------------------
// ParserState
// ---------------------------------------------------------------------------
class ParserState {
    Token current
    Token previous
    bool had_error
    bool panic_mode

    func new() {
        self.current    = make_eof_token()
        self.previous   = make_eof_token()
        self.had_error  = false
        self.panic_mode = false
    }
}

// ---------------------------------------------------------------------------
// MacroEntry
// ---------------------------------------------------------------------------
class MacroEntry {
    str       name
    ASTNode   decl
    MacroEntry? next

    func new(str n, ASTNode d) {
        self.name = n
        self.decl = d
        self.next = null
    }
}
