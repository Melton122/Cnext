// Self-hosting bootstrap: main driver
// Port of src/main.c
// Supports both the legacy single-source codegen path and the bootstrap
// bundle-based self-hosting path.

import process
import os

extern "C" func os_executable_path(): str
extern "C" func cnext_native_manifest_args(str path, bool required): str

// Keep in sync with CNEXT_VERSION in include/main_internal.h.
const str CNEXT_VERSION_STR = "10.0.5"
extern "C" func cnext_test_execute(str[] argv, str stdin_path, str output_path): int
extern "C" func cnext_test_list_directory(str path): str

str g_pkg_visited = ""

func pkg_is_space(char c): bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

func pkg_is_std_name(str name): bool {
    if name == "io" { return true }
    if name == "file" { return true }
    if name == "net" { return true }
    if name == "json" { return true }
    if name == "math" { return true }
    if name == "os" { return true }
    if name == "string_utils" { return true }
    if name == "time" { return true }
    if name == "regex" { return true }
    if name == "collections" { return true }
    if name == "crypto" { return true }
    if name == "path" { return true }
    if name == "encoding" { return true }
    if name == "process" { return true }
    if name == "random" { return true }
    if name == "thread" { return true }
    if name == "http" { return true }
    if name == "log" { return true }
    if name == "args" { return true }
    if name == "fmt" { return true }
    return false
}

func pkg_is_safe_name(str name): bool {
    int n = len(name)
    if n == 0 { return false }
    int i = 0
    while i < n {
        char c = str_char_at(name, i)
        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
                  (c >= '0' && c <= '9') || c == '_' || c == '-'
        if !ok { return false }
        i = i + 1
    }
    return true
}

func pkg_is_visited(str name): bool {
    return str_contains(g_pkg_visited, "|" + name + "|")
}

func import_is_absolute(str path): bool {
    int n = len(path)
    if n == 0 { return false }
    char first = str_char_at(path, 0)
    if first == '/' || first == '\\' { return true }
    if n >= 2 && str_char_at(path, 1) == ':' { return true }
    return false
}

func import_basename_has_dot(str spec): bool {
    int i = len(spec) - 1
    while i >= 0 {
        char c = str_char_at(spec, i)
        if c == '/' || c == '\\' { return false }
        if c == '.' { return true }
        i = i - 1
    }
    return false
}

// Collapses "./" path segments so two spellings of one file share a single
// visited entry (and are merged only once).
func import_normalize(str path): str {
    str out = path
    int guard = 0
    bool changed = true
    while changed && guard < 32 {
        guard = guard + 1
        str next = str_replace(out, "/./", "/")
        next = str_replace(next, "\\.\\", "\\")
        int n = len(next)
        if n > 2 && str_substring(next, 0, 2) == "./" { next = str_substring(next, 2, n) }
        if n > 2 && str_substring(next, 0, 2) == ".\\" { next = str_substring(next, 2, n) }
        changed = next != out
        out = next
    }
    return out
}

// Resolves an `import "..."` spec against the directory of the file that
// contains it, adding ".cn" when the basename has no extension.
func import_resolve(str base_dir, str spec): str {
    str name = spec
    int n = len(name)
    // `!` on a grouped comparison is miscompiled as `!a > b` in this
    // compiler, so negate plain booleans instead of parenthesized tests.
    bool has_cn_suffix = n > 3 && str_substring(name, n - 3, n) == ".cn"
    bool base_has_dot = import_basename_has_dot(name)
    if !has_cn_suffix && !base_has_dot {
        name = name + ".cn"
    }
    if import_is_absolute(name) { return import_normalize(name) }
    str dir = base_dir
    if len(dir) == 0 { dir = "." }
    char last = str_char_at(dir, len(dir) - 1)
    if last == '/' || last == '\\' { return import_normalize(dir + name) }
    return import_normalize(dir + "/" + name)
}

// Expands local imports and packages into one translation unit. The result is
// this file in final order: imported code first, then the file itself, with
// `map` keeping line origins in step so diagnostics name the real file.
func collect_package_sources(str raw_text, str base_dir, str file_path, bool privatize): Expansion {
    // Each file is rewritten before it is merged: `export` disappears, and
    // non-exported top-level names get a suffix unique to this file.
    int module_tag = g_priv_next_tag
    g_priv_next_tag = g_priv_next_tag + 1
    str text = priv_module_source(raw_text, privatize ? module_tag : -1)
    str combined = ""
    OriginMap combined_map = origin_map_create()
    int n = len(text)
    int i = 0
    while i < n {
        while i < n && pkg_is_space(str_char_at(text, i)) {
            i = i + 1
        }
        if i + 1 < n && str_char_at(text, i) == '/' && str_char_at(text, i + 1) == '/' {
            while i < n && str_char_at(text, i) != '\n' {
                i = i + 1
            }
            continue
        }
        if i + 1 < n && str_char_at(text, i) == '/' && str_char_at(text, i + 1) == '*' {
            i = i + 2
            while i + 1 < n && !(str_char_at(text, i) == '*' && str_char_at(text, i + 1) == '/') {
                i = i + 1
            }
            if i + 1 < n { i = i + 2 }
            continue
        }
        if i + 6 <= n && str_substring(text, i, i + 6) == "import" &&
           i + 6 < n && pkg_is_space(str_char_at(text, i + 6)) {
            int j = i + 6
            while j < n && pkg_is_space(str_char_at(text, j)) {
                j = j + 1
            }
            if j < n && str_char_at(text, j) == '"' {
                // Local file import: `import "../util.cn"`.
                j = j + 1
                int spec_start = j
                while j < n && str_char_at(text, j) != '"' && str_char_at(text, j) != '\n' {
                    j = j + 1
                }
                str spec = str_substring(text, spec_start, j)
                if len(spec) == 0 {
                    print("error: empty import path\n")
                    exit(65)
                }
                str resolved = import_resolve(base_dir, spec)
                if !pkg_is_visited(resolved) {
                    g_pkg_visited = g_pkg_visited + "|" + resolved + "|"
                    str module_source = read_file(resolved)
                    if module_source == null {
                        print("error: cannot open imported file \"" + spec + "\" (looked for \"" + resolved + "\")\n")
                        exit(65)
                    }
                    Expansion child = collect_package_sources(module_source, driver_directory(resolved), resolved, privatize)
                    str block = child.text
                    if len(block) > 0 && str_char_at(block, len(block) - 1) != '\n' {
                        block = block + "\n"
                    }
                    OriginMap next_map = origin_map_create()
                    if child.map.count == 0 {
                        // No imports of its own: the whole module is one block.
                        origin_map_add(next_map, 1, origin_count_lines(block), resolved, 1)
                    } else {
                        origin_map_append(next_map, child.map, 0)
                    }
                    origin_map_append(next_map, combined_map, origin_newline_count(block))
                    combined = block + combined
                    combined_map = next_map
                }
                if j < n && str_char_at(text, j) == '"' { j = j + 1 }
                i = j
                continue
            }
            int name_start = j
            while j < n && !pkg_is_space(str_char_at(text, j)) &&
                  str_char_at(text, j) != ';' {
                j = j + 1
            }
            str name = str_substring(text, name_start, j)
            if !pkg_is_std_name(name) && pkg_is_safe_name(name) && !pkg_is_visited(name) {
                g_pkg_visited = g_pkg_visited + "|" + name + "|"
                str pkg_path = "packages/" + name + ".cn"
                str pkg_source = read_file(pkg_path)
                if pkg_source != null {
                    // Package code keeps its names and its plain line numbers.
                    Expansion pkg = collect_package_sources(pkg_source, base_dir, pkg_path, false)
                    str block = pkg.text
                    if len(block) > 0 && str_char_at(block, len(block) - 1) != '\n' {
                        block = block + "\n"
                    }
                    OriginMap next_map = origin_map_create()
                    origin_map_append(next_map, combined_map, origin_newline_count(block))
                    combined = block + combined
                    combined_map = next_map
                }
            }
            i = j
        }
        i = i + 1
    }

    if combined_map.count > 0 {
        // Imported code is pasted first, so this file starts after it.
        origin_map_add(combined_map, origin_newline_count(combined) + 1,
                       origin_count_lines(text), file_path, 1)
    }
    return new Expansion(combined + text, combined_map)
}

func build_source_with_packages(str source, str source_dir, str source_path): str {
    g_pkg_visited = ""
    g_priv_privatize = priv_has_local_import(source)
    g_priv_next_tag = 0
    Expansion result = collect_package_sources(source, source_dir, source_path, g_priv_privatize)
    // Only map positions when local imports actually moved lines; package
    // sources keep reporting plain merged line numbers.
    if result.map.count > 0 {
        g_origin_map = result.map
    } else {
        g_origin_map = null
    }
    return result.text
}


func driver_usage() {
    print("Cnext Compiler v" + CNEXT_VERSION_STR + "\n")
    print("Usage: cnext <command> [arguments]\n\n")
    print("Commands:\n")
    print("  new <ProjectName>              Create a new Cnext project.\n")
    print("  run <file.cn> [options]        Compile and run a Cnext file.\n")
    print("  build <file.cn> [options]      Compile a Cnext file to an executable.\n")
    print("  fmt <file.cn>                  Format a Cnext file.\n")
    print("  lint <file.cn>                 Lint a Cnext file.\n")
    print("  init [ProjectName]             Initialize cnext.toml.\n")
    print("  test [filter|file.cn] [--list] Run project tests.\n")
    print("  version                        Show compiler version.\n")
    print("  help                           Show this help message.\n\n")
    print("Development tools:\n")
    print("  doctor, repl, upgrade, cache, config, doc\n")
    print("Package manager:\n")
    print("  install, remove, update, search, info, publish, login, logout\n\n")
    print("Build Options:\n")
    print("  -o <path>                      Set output file path.\n")
    print("  --optimize                     Enable the (experimental) Cnext-level optimizer.\n")
    print("  --no-optimize                  Disable the optimizer (overrides --optimize).\n")
    print("  --emit-c <path>                Write generated C to <path> and skip GCC.\n")
    print("  --c-source <path>              Compile an additional C source (repeatable).\n")
    print("  --object <path>                Link an object or archive (repeatable).\n")
    print("  --include-dir <path>           Add a C header search directory (repeatable).\n")
    print("  --library-dir <path>           Add a library search directory (repeatable).\n")
    print("  --link-lib <name>              Link a C library by name (repeatable).\n")
    print("  --cc <path>                    Select the C compiler.\n")
    print("  --runtime-dir <path>           Select the runtime header directory.\n")
    print("  --manifest <path>              Read native settings from this manifest.\n")
    print("  --no-native-config             Ignore native settings in cnext.toml.\n")
}

func driver_error(str message) {
    print(message + "\n")
    exit(64)
}

func driver_directory(str path): str {
    int i = len(path) - 1
    while i >= 0 {
        char c = str_char_at(path, i)
        if c == '/' || c == '\\' { return str_substring(path, 0, i + 1) }
        i = i - 1
    }
    return "./"
}

func driver_runtime_dir(): str {
    str configured = getenv("CNEXT_INCLUDE")
    if configured != null && len(configured) > 0 { return configured }
    if file_exists("include/runtime.h") { return "include" }
    str compiler_dir = driver_directory(os_executable_path())
    if file_exists(compiler_dir + "../share/cnext/include/runtime.h") { return compiler_dir + "../share/cnext/include" }
    if file_exists(compiler_dir + "../include/runtime.h") { return compiler_dir + "../include" }
    if file_exists(compiler_dir + "../../include/runtime.h") { return compiler_dir + "../../include" }
    if file_exists(compiler_dir + "include/runtime.h") { return compiler_dir + "include" }
    return ""
}

func driver_write(str path, str content) {
    write_file(path, content)
    if read_file(path) != content {
        print("Could not write output: " + path + "\n")
        exit(74)
    }
}

func driver_network_import(ASTNode ast): bool {
    int i = 0
    while i < len(ast.children) {
        var child = ast.children[i]
        if child.kind == AST_IMPORT && (child.token.text == "net" || child.token.text == "http") { return true }
        i = i + 1
    }
    return false
}

func driver_executable(str path): str {
    if len(path) > 0 && (str_char_at(path, 0) == '/' || str_char_at(path, 0) == '\\') { return path }
    if len(path) > 1 && str_char_at(path, 1) == ':' { return path }
    return "./" + path
}

// The test command runs this compiler's build path, not the C bootstrap.
class DriverTestSuite {
    str root
    str[] files
    func new(str path) { self.root = path self.files = {} }
}

func driver_test_join(str root, str name): str {
    if len(root) == 0 { return name }
    char last = str_char_at(root, len(root) - 1)
    if last == '/' || last == '\\' { return root + name }
    return root + "/" + name
}

func driver_test_cn(str name): bool {
    return len(name) > 3 && str_substring(name, len(name) - 3, len(name)) == ".cn"
}

func driver_test_collect(DriverTestSuite suite, str directory, str prefix, str filter, int depth) {
    if depth > 32 { driver_error("Test directory nesting exceeds 32 levels") }
    str listing = cnext_test_list_directory(directory)
    if is_null(listing) { print("Could not read test directory: " + directory + "\n"); exit(74) }
    var names = str_split(listing, "\n")
    int i = 0
    while i < len(names) {
        str name = names[i]
        i = i + 1
        if len(name) == 0 || str_char_at(name, 0) == '.' { continue }
        str path = driver_test_join(directory, name)
        str relative = driver_test_join(prefix, name)
        if os_is_dir(path) {
            if name != "bootstrap" && name != "optimizer" {
                driver_test_collect(suite, path, relative, filter, depth + 1)
            }
        } else if driver_test_cn(name) && (len(filter) == 0 || str_contains(relative, filter)) {
            if len(suite.files) >= 512 { driver_error("Test suite exceeds 512 source files") }
            push(suite.files, relative)
        }
    }
}

func driver_test_before(str a, str b): bool {
    int i = 0
    while i < len(a) && i < len(b) {
        int left = str_char_at(a, i)
        int right = str_char_at(b, i)
        if left != right { return left < right }
        i = i + 1
    }
    return len(a) < len(b)
}

func driver_test_sort(DriverTestSuite suite) {
    int i = 1
    while i < len(suite.files) {
        str name = suite.files[i]
        int j = i
        while j > 0 && driver_test_before(name, suite.files[j - 1]) {
            suite.files[j] = suite.files[j - 1]
            j = j - 1
        }
        suite.files[j] = name
        i = i + 1
    }
}

class DriverTestSpec {
    str[] expects
    str input
    int status
    bool valid
    func new() { self.expects = {} self.input = "" self.status = 0 self.valid = true }
}

func driver_test_spec(str source): DriverTestSpec {
    var spec = new DriverTestSpec()
    bool has_status = false
    var lines = str_split(source, "\n")
    int i = 0
    while i < len(lines) {
        str line = lines[i]
        i = i + 1
        if len(line) > 0 && str_char_at(line, len(line) - 1) == '\r' {
            line = str_substring(line, 0, len(line) - 1)
        }
        if str_starts_with(line, "// EXPECT:") {
            int start = 10
            if len(line) > start && str_char_at(line, start) == ' ' { start = start + 1 }
            if len(spec.expects) >= 512 { spec.valid = false }
            else { push(spec.expects, str_substring(line, start, len(line))) }
        } else if str_starts_with(line, "// STDIN:") {
            int start = 9
            if len(line) > start && str_char_at(line, start) == ' ' { start = start + 1 }
            spec.input = spec.input + str_substring(line, start, len(line)) + "\n"
            if len(spec.input) > 16384 { spec.valid = false }
        } else if str_starts_with(line, "// EXIT:") {
            str value = str_trim(str_substring(line, 8, len(line)))
            if has_status || len(value) == 0 { spec.valid = false }
            has_status = true
            int j = 0
            int status = 0
            while j < len(value) {
                char digit = str_char_at(value, j)
                if digit < '0' || digit > '9' { spec.valid = false break }
                if status > 255 { spec.valid = false break }
                status = status * 10 + (digit as int) - 48
                j = j + 1
            }
            if status > 255 { spec.valid = false }
            spec.status = status
        }
    }
    return spec
}

func driver_test_matches(str output, str[] expects): bool {
    int cursor = 0
    int i = 0
    while i < len(expects) {
        str expected = expects[i]
        bool found = false
        while cursor <= len(output) - len(expected) {
            int j = 0
            while j < len(expected) && str_char_at(output, cursor + j) == str_char_at(expected, j) { j = j + 1 }
            if j == len(expected) { cursor = cursor + len(expected) found = true break }
            cursor = cursor + 1
        }
        if !found { return false }
        i = i + 1
    }
    return true
}

func driver_test_cleanup(str base, str binary) {
    delete_file(binary)
    delete_file(base + ".build.log")
    delete_file(base + ".run.log")
    delete_file(base + ".stdin")
}

func driver_test_command(int argument_count): int {
    bool list = false
    str selection = ""
    str[] options = {}
    int i = 2
    while i < argument_count {
        str arg = sys_arg_at(i)
        if arg == "--list" { list = true i = i + 1 }
        else if arg == "--no-native-config" || arg == "--optimize" || arg == "--no-optimize" { push(options, arg) i = i + 1 }
        else if arg == "--cc" || arg == "--runtime-dir" || arg == "--manifest" ||
                arg == "--include-dir" || arg == "--c-source" || arg == "--object" ||
                arg == "--library-dir" || arg == "--link-lib" {
            if i + 1 >= argument_count { driver_error("Missing value after " + arg) }
            push(options, arg) push(options, sys_arg_at(i + 1)) i = i + 2
        } else {
            if len(arg) == 0 || str_char_at(arg, 0) == '-' { driver_error("Unknown test option: " + arg) }
            if len(selection) > 0 { driver_error("Expected one test filter, file, or directory") }
            selection = arg i = i + 1
        }
    }
    var suite = new DriverTestSuite("tests")
    if len(selection) > 0 && os_is_dir(selection) {
        suite.root = selection
        driver_test_collect(suite, selection, "", "", 0)
    } else if len(selection) > 0 && driver_test_cn(selection) && file_exists(selection) {
        suite.root = ""
        push(suite.files, selection)
    } else {
        if len(selection) > 0 && (str_contains(selection, "/") || str_contains(selection, "\\")) {
            print("Test path does not exist: " + selection + "\n") return 74
        }
        if !os_is_dir("tests") { print("Could not open test directory 'tests'.\n") return 74 }
        driver_test_collect(suite, "tests", "", selection, 0)
    }
    driver_test_sort(suite)
    if len(suite.files) == 0 { print("No test files found.\n") return 1 }
    if list {
        i = 0
        while i < len(suite.files) { printin(suite.files[i]) i = i + 1 }
        return 0
    }
    print("Running " + to_str(len(suite.files)) + " Cnext test files...\n\n")
    int passed = 0
    int failed = 0
    i = 0
    while i < len(suite.files) {
        str name = suite.files[i]
        str path = driver_test_join(suite.root, name)
        str source = read_file(path)
        if source == null { print("  FAIL: " + name + " (could not read source)\n") failed = failed + 1 i = i + 1 continue }
        var spec = driver_test_spec(source)
        if !spec.valid { print("  FAIL: " + name + " (invalid EXPECT/STDIN/EXIT metadata)\n") failed = failed + 1 i = i + 1 continue }
        str base = "./.cnext-test-" + to_str(os_pid()) + "-" + to_str(i)
        str binary = base
        if platform() == "windows" { binary = binary + ".exe" }
        if file_exists(binary) || file_exists(base + ".build.log") || file_exists(base + ".run.log") || file_exists(base + ".stdin") {
            print("  FAIL: " + name + " (temporary test path already exists)\n") failed = failed + 1 i = i + 1 continue
        }
        str[] build = {sys_arg_at(0), "build", path, "-o", binary}
        int j = 0
        while j < len(options) { push(build, options[j]) j = j + 1 }
        int build_status = cnext_test_execute(build, "", base + ".build.log")
        if build_status != 0 {
            print("  FAIL: " + name + " (compile error)\n")
            str log = read_file(base + ".build.log")
            if log != null { print(log) }
            failed = failed + 1
        } else {
            driver_write(base + ".stdin", spec.input)
            str[] command = {driver_executable(binary)}
            int status = cnext_test_execute(command, base + ".stdin", base + ".run.log")
            bool bounded = os_file_size(base + ".run.log") <= 1048576
            str output = ""
            if bounded { output = read_file(base + ".run.log") }
            bool matches = bounded && !is_null(output) && driver_test_matches(output, spec.expects)
            if status == spec.status && matches {
                print("  PASS: " + name + "\n") passed = passed + 1
            } else {
                print("  FAIL: " + name + "\n")
                if status != spec.status { print("    program exited with status " + to_str(status) + "; expected " + to_str(spec.status) + "\n") }
                if !bounded { print("    output exceeds 1 MiB limit\n") }
                else if !matches { print("    output did not contain all expected text in order\n") }
                if output != null && len(output) > 0 { print("    output: " + output) }
                failed = failed + 1
            }
        }
        driver_test_cleanup(base, binary)
        i = i + 1
    }
    print("\nResults: " + to_str(passed) + " passed, " + to_str(failed) + " failed\n")
    if failed > 0 { return 1 }
    return 0
}

main {
    int argument_count = sys_args_count()
    if argument_count < 2 { driver_usage(); exit(2) }
    str first = sys_arg_at(1)
    if first == "help" || first == "--help" || first == "-h" { driver_usage(); exit(0) }
    if first == "doctor" || first == "repl" || first == "upgrade" || first == "cache" ||
       first == "config" || first == "doc" || first == "install" || first == "remove" ||
       first == "update" || first == "search" || first == "info" || first == "publish" ||
       first == "login" || first == "logout" {
        str executable = os_executable_path()
        if executable == null { driver_error("Could not locate the compiler executable") }
        str companion = driver_directory(executable) + "cnext-tools"
        if os_os_name() == "Windows" { companion = companion + ".exe" }
        if !file_exists(companion) { driver_error("Missing native tools companion: " + companion) }
        if first == "repl" {
            str runtime_dir = driver_runtime_dir()
            if len(runtime_dir) > 0 { os_setenv("CNEXT_INCLUDE", runtime_dir) }
        }
        str[] args = {companion}
        int index = 1
        while index < argument_count { push(args, sys_arg_at(index)); index = index + 1 }
        exit(process_spawn(args))
    }
    if first == "init" {
        str name = "my-project"
        if argument_count >= 3 { name = sys_arg_at(2) }
        str content = "[package]\nname = \"" + name + "\"\nversion = \"0.1.0\"\ndescription = \"A Cnext project\"\n\n[dependencies]\n"
        if os_os_name() == "Windows" { content = str_replace(content, "\n", "\r\n") }
        if write_file("cnext.toml", content) == false {
            cnext_eprint("Could not create cnext.toml\n")
            exit(1)
        }
        print("Created cnext.toml for project '" + name + "'\n")
        exit(0)
    }
    if first == "new" {
        // cnext new <ProjectName> scaffolds a project, like stage 0.
        if argument_count < 3 {
            cnext_eprint("Usage: cnext new <ProjectName>\n")
            exit(64)
        }
        exit(create_project(sys_arg_at(2)))
    }
    if first == "fmt" {
        // cnext fmt <file.cn> rewrites the file in place, like stage 0.
        if argument_count < 3 {
            print("Usage: cnext fmt <file.cn>\n")
            exit(64)
        }
        str fmt_path = sys_arg_at(2)
        str fmt_source = read_file(fmt_path)
        if fmt_source == null {
            print("Could not open file \"" + fmt_path + "\"\n")
            exit(1)
        }
        driver_write(fmt_path, format_source(fmt_source))
        exit(0)
    }
    if first == "lint" {
        // cnext lint <file.cn> reports issues on stderr, like stage 0.
        if argument_count < 3 {
            print("Usage: cnext lint <file.cn>\n")
            exit(64)
        }
        str lint_path = sys_arg_at(2)
        str lint_source_text = read_file(lint_path)
        if lint_source_text == null {
            print("Could not open file \"" + lint_path + "\"\n")
            exit(1)
        }
        lint_source(lint_source_text)
        lint_print_issues()
        exit(0)
    }
    if first == "version" {
        print("Cnext version " + CNEXT_VERSION_STR + "\n")
        exit(0)
    }
    if first == "test" { exit(driver_test_command(argument_count)) }
    bool legacy = first != "build" && first != "run"
    str mode = first
    str source_path = ""
    int i = 2
    if legacy { mode = "emit"; source_path = first }
    str output_path = ""
    str emit_path = ""
    str runtime_dir = ""
    str compiler = "gcc"
    str manifest_path = "cnext.toml"
    bool manifest_explicit = false
    bool no_native_config = false
    bool enable_optimize = false
    bool no_optimize = false
    str[] native_args = {}
    str[] library_args = {}
    str[] program_args = {}
    while i < argument_count {
        str arg = sys_arg_at(i)
        if arg == "--" {
            if mode != "run" || len(source_path) == 0 { driver_error("Program arguments require run <file.cn> -- args...") }
            i = i + 1
            while i < argument_count { push(program_args, sys_arg_at(i)); i = i + 1 }
        } else if arg == "--no-native-config" {
            no_native_config = true
            i = i + 1
        } else if arg == "--optimize" {
            enable_optimize = true
            i = i + 1
        } else if arg == "--no-optimize" {
            no_optimize = true
            i = i + 1
        } else if arg == "-o" || arg == "--emit-c" || arg == "--cc" || arg == "--runtime-dir" || arg == "--manifest" ||
                  arg == "--include-dir" || arg == "--c-source" || arg == "--object" ||
                  arg == "--library-dir" || arg == "--link-lib" {
            if i + 1 >= argument_count { driver_error("Missing value after " + arg) }
            str value = sys_arg_at(i + 1)
            if len(value) == 0 { driver_error("Empty value after " + arg) }
            if arg == "-o" {
                if len(output_path) > 0 { driver_error("Duplicate -o option") }
                output_path = value
            } else if arg == "--emit-c" {
                if len(emit_path) > 0 { driver_error("Duplicate --emit-c option") }
                emit_path = value
            } else if arg == "--cc" { compiler = value }
            else if arg == "--manifest" {
                if manifest_explicit || str_char_at(value, 0) == '-' { driver_error("Expected one manifest path after --manifest") }
                manifest_path = value
                manifest_explicit = true
            }
            else if arg == "--runtime-dir" { runtime_dir = value }
            else if arg == "--library-dir" { push(native_args, "-L"); push(native_args, value) }
            else if arg == "--link-lib" { push(library_args, "-l"); push(library_args, value) }
            else {
                if arg == "--include-dir" { push(native_args, "-I") }
                push(native_args, value)
            }
            i = i + 2
        } else {
            if str_char_at(arg, 0) == '-' { driver_error("Unknown option: " + arg) }
            if len(source_path) > 0 { driver_error("Expected one input source; use --c-source for C files") }
            source_path = arg
            i = i + 1
        }
    }
    if len(source_path) == 0 { driver_usage(); exit(64) }
    if len(emit_path) > 0 {
        if mode == "run" || len(output_path) > 0 { driver_error("--emit-c cannot be combined with run or -o") }
        mode = "emit"
        output_path = emit_path
    }
    if mode == "emit" && (len(native_args) > 0 || len(library_args) > 0) {
        driver_error("C emission cannot be combined with native build options")
    }
    if manifest_explicit && no_native_config { driver_error("Cannot combine --manifest with --no-native-config") }
    if mode != "emit" && !no_native_config {
        str settings = cnext_native_manifest_args(manifest_path, manifest_explicit)
        str[] configured = str_split(settings, "\n")
        str[] merged_native = {}
        str[] merged_libraries = {}
        int j = 0
        while j < len(configured) {
            str option = configured[j]
            str value = configured[j + 1]
            if option == "--link-lib" {
                push(merged_libraries, "-l")
                push(merged_libraries, value)
            } else {
                if option == "--include-dir" { push(merged_native, "-I") }
                if option == "--library-dir" { push(merged_native, "-L") }
                push(merged_native, value)
            }
            j = j + 2
        }
        j = 0
        while j < len(native_args) { push(merged_native, native_args[j]); j = j + 1 }
        j = 0
        while j < len(library_args) { push(merged_libraries, library_args[j]); j = j + 1 }
        native_args = merged_native
        library_args = merged_libraries
    }
    if len(native_args) > 128 || len(library_args) > 128 { driver_error("Too many native build arguments (maximum 128 per group)") }
    str raw_source = read_file(source_path)
    if raw_source == null { print("Error reading file: " + source_path + "\n"); exit(74) }
    str source = build_source_with_packages(raw_source, driver_directory(source_path), source_path)
    ASTNode? ast = parse_program(source)
    if ast == null { print("Parse failed\n"); exit(65) }
    if !analyze_program(ast) { print("Semantic analysis failed\n"); exit(65) }
    if enable_optimize && !no_optimize { optimize_ast(ast) }
    codegen_init(ast)
    generate_program(ast)
    str generated = codegen_flush_output()
    if mode == "emit" {
        if len(output_path) > 0 {
            driver_write(output_path, generated)
        } else { print(generated) }
    } else {
        if len(runtime_dir) == 0 { runtime_dir = driver_runtime_dir() }
        if !file_exists(runtime_dir + "/runtime.h") {
            print("Cannot find runtime.h; use --runtime-dir or CNEXT_INCLUDE\n")
            exit(74)
        }
        str tag = to_str(os_pid())
        str c_path = "./.cnext-" + tag + ".c"
        bool temporary_program = mode == "run" && len(output_path) == 0
        if len(output_path) == 0 {
            if temporary_program { output_path = "./.cnext-run-" + tag }
            else { output_path = "a.out" }
            if platform() == "windows" {
                if temporary_program { output_path = output_path + ".exe" }
                else { output_path = "a.exe" }
            }
        }
        if file_exists(c_path) || (temporary_program && file_exists(output_path)) {
            print("Temporary build path already exists; refusing to overwrite it\n")
            exit(74)
        }
        driver_write(c_path, generated)
        str[] command = {compiler, "-std=gnu11", "-O0", "-w", "-iquote", runtime_dir, c_path, "-o", output_path}
        int j = 0
        while j < len(native_args) { push(command, native_args[j]); j = j + 1 }
        j = 0
        while j < len(library_args) { push(command, library_args[j]); j = j + 1 }
        if platform() == "windows" {
            if driver_network_import(ast) { push(command, "-lwinhttp"); push(command, "-lws2_32") }
        } else {
            if driver_network_import(ast) { push(command, "-lcurl") }
            push(command, "-lpthread")
            push(command, "-lm")
        }
        // The generated C already lives in this writable directory. Keep GCC's
        // intermediate files here too, including on redirected Windows profiles.
        str old_tmpdir = getenv("TMPDIR")
        str old_tmp = getenv("TMP")
        str old_temp = getenv("TEMP")
        os_setenv("TMPDIR", ".")
        os_setenv("TMP", ".")
        os_setenv("TEMP", ".")
        int status = process_spawn(command)
        if old_tmpdir == null { os_unsetenv("TMPDIR") } else { os_setenv("TMPDIR", old_tmpdir) }
        if old_tmp == null { os_unsetenv("TMP") } else { os_setenv("TMP", old_tmp) }
        if old_temp == null { os_unsetenv("TEMP") } else { os_setenv("TEMP", old_temp) }
        delete_file(c_path)
        if status != 0 { print("C compilation failed\n"); exit(status) }
        if mode == "run" {
            str[] invocation = {driver_executable(output_path)}
            j = 0
            while j < len(program_args) { push(invocation, program_args[j]); j = j + 1 }
            status = process_spawn(invocation)
            if temporary_program { delete_file(output_path) }
            exit(status)
        }
    }
}
