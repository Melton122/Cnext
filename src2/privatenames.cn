// Self-hosting bootstrap: private names
// Port of src/private_names.c
//
// Every file in a program that uses `import "./..."` is rewritten before it is
// merged: `export` is removed from top-level declarations, and the names of
// top-level declarations that are *not* exported get a suffix unique to that
// file (`helper` -> `helper__m3`). The rewrite is purely lexical, so line
// numbers never move.
//
// The scanner here must behave exactly like the C one: same whitespace,
// comment, literal, brace and `export`/declaration handling.

class PrivTok {
    int start
    int end
    int kind

    func new(int start_index, int end_index, int token_kind) {
        self.start = start_index
        self.end = end_index
        self.kind = token_kind
    }
}

class PrivSpan {
    int start
    int end

    func new(int start_index, int end_index) {
        self.start = start_index
        self.end = end_index
    }
}

class PrivSpans {
    PrivSpan[] items
    int count

    func new() {
        self.items = {}
        self.count = 0
    }
}

// Token kinds shared with src/private_names.c.
int PRIV_IDENT = 1
int PRIV_PUNCT = 2
int PRIV_SKIP = 3

bool g_priv_privatize = false
int g_priv_next_tag = 0

func priv_is_space(char c): bool {
    return c == ' ' || c == '\t' || c == '\r' || c == '\n'
}

func priv_is_digit(char c): bool {
    return c >= '0' && c <= '9'
}

func priv_is_alpha(char c): bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

func priv_is_ident_start(char c): bool {
    return priv_is_alpha(c) || c == '_'
}

func priv_is_ident_char(char c): bool {
    return priv_is_alpha(c) || priv_is_digit(c) || c == '_'
}

func priv_span_add(PrivSpans spans, int start, int end) {
    push(spans.items, new PrivSpan(start, end))
    spans.count = spans.count + 1
}

func priv_span_contains(PrivSpans spans, int start, int end): bool {
    int i = 0
    while i < spans.count {
        if spans.items[i].start == start && spans.items[i].end == end {
            return true
        }
        i = i + 1
    }
    return false
}

// The same text appears at two offsets in `source` (string equality on two
// `str` values is not available here, so compare characters).
func priv_same_text(str source, int start_a, int end_a, int start_b, int end_b): bool {
    if end_a - start_a != end_b - start_b {
        return false
    }
    int i = 0
    while i < end_a - start_a {
        if str_char_at(source, start_a + i) != str_char_at(source, start_b + i) {
            return false
        }
        i = i + 1
    }
    return true
}

func priv_span_has_name(str source, PrivTok token, PrivSpans spans): bool {
    int i = 0
    while i < spans.count {
        PrivSpan span = spans.items[i]
        if priv_same_text(source, span.start, span.end, token.start, token.end) {
            return true
        }
        i = i + 1
    }
    return false
}

// Skips whitespace and returns the end offset of the token that starts at
// `token.start`.
func priv_scan(str source, int index, int length, PrivTok token): int {
    int i = index
    while i < length && priv_is_space(str_char_at(source, i)) {
        i = i + 1
    }
    token.start = i
    if i >= length {
        token.end = length
        token.kind = PRIV_SKIP
        return length
    }

    char c = str_char_at(source, i)

    if c == '/' && i + 1 < length {
        char next = str_char_at(source, i + 1)
        if next == '/' {
            int j = i + 2
            while j < length && str_char_at(source, j) != '\n' {
                j = j + 1
            }
            token.end = j
            token.kind = PRIV_SKIP
            return j
        }
        if next == '*' {
            int j = i + 2
            while j + 1 < length && !(str_char_at(source, j) == '*' && str_char_at(source, j + 1) == '/') {
                j = j + 1
            }
            if j + 1 < length {
                j = j + 2
            }
            token.end = j
            token.kind = PRIV_SKIP
            return j
        }
    }

    if c == '"' || c == '\'' {
        char quote = c
        int j = i + 1
        bool done = false
        while j < length && !done {
            char d = str_char_at(source, j)
            if d == '\\' && j + 1 < length {
                j = j + 2
                continue
            }
            if d == quote {
                j = j + 1
                done = true
                continue
            }
            if d == '\n' {
                done = true
                continue
            }
            j = j + 1
        }
        token.end = j
        token.kind = PRIV_SKIP
        return j
    }

    if priv_is_digit(c) {
        int j = i + 1
        while j < length {
            char d = str_char_at(source, j)
            if priv_is_alpha(d) || priv_is_digit(d) || d == '.' || d == '_' {
                j = j + 1
                continue
            }
            break
        }
        token.end = j
        token.kind = PRIV_SKIP
        return j
    }

    if priv_is_ident_start(c) {
        int j = i + 1
        while j < length && priv_is_ident_char(str_char_at(source, j)) {
            j = j + 1
        }
        token.end = j
        token.kind = PRIV_IDENT
        return j
    }

    token.end = i + 1
    token.kind = PRIV_PUNCT
    return i + 1
}

func priv_token_is(str source, PrivTok token, str text): bool {
    return token.end - token.start == len(text) &&
           str_substring(source, token.start, token.end) == text
}

func priv_is_type_keyword(str source, PrivTok token): bool {
    return priv_token_is(source, token, "int") ||
           priv_token_is(source, token, "long") ||
           priv_token_is(source, token, "float") ||
           priv_token_is(source, token, "double") ||
           priv_token_is(source, token, "str") ||
           priv_token_is(source, token, "bool") ||
           priv_token_is(source, token, "char") ||
           priv_token_is(source, token, "byte") ||
           priv_token_is(source, token, "uint") ||
           priv_token_is(source, token, "ulong") ||
           priv_token_is(source, token, "void") ||
           priv_token_is(source, token, "var") ||
           priv_token_is(source, token, "const")
}

// A declaration may name its type first (`const int LIMIT = 3`), so the type
// token is not the declared name.
func priv_is_builtin_type_name(str source, PrivTok token): bool {
    return priv_token_is(source, token, "int") ||
           priv_token_is(source, token, "long") ||
           priv_token_is(source, token, "float") ||
           priv_token_is(source, token, "double") ||
           priv_token_is(source, token, "str") ||
           priv_token_is(source, token, "bool") ||
           priv_token_is(source, token, "char") ||
           priv_token_is(source, token, "byte") ||
           priv_token_is(source, token, "uint") ||
           priv_token_is(source, token, "ulong")
}

func priv_is_declaration_keyword(str source, PrivTok token): bool {
    return priv_token_is(source, token, "func") ||
           priv_token_is(source, token, "class") ||
           priv_token_is(source, token, "struct") ||
           priv_token_is(source, token, "enum") ||
           priv_token_is(source, token, "trait") ||
           priv_token_is(source, token, "interface") ||
           priv_token_is(source, token, "var") ||
           priv_token_is(source, token, "const") ||
           priv_token_is(source, token, "type")
}

// Member accesses (`.name`) and attribute names (`@name`) keep their spelling:
// a field may legally share a name with a private top-level declaration.
func priv_is_member_or_attribute_name(str source, int start): bool {
    int j = start - 1
    while j >= 0 {
        char c = str_char_at(source, j)
        if priv_is_space(c) {
            j = j - 1
            continue
        }
        return c == '.' || c == '@'
    }
    return false
}

func priv_scan_declarations(str source, PrivSpans exports, PrivSpans privates, PrivSpans shadows) {
    int length = len(source)
    int depth = 0
    int i = 0
    bool pending_export = false
    bool expect_name = false
    bool expect_value_name = false

    while i < length {
        PrivTok token = new PrivTok(0, 0, 0)
        int end = priv_scan(source, i, length, token)
        i = end

        if token.kind == PRIV_SKIP {
            expect_name = false
            expect_value_name = false
            continue
        }

        if token.kind == PRIV_IDENT && expect_value_name {
            if priv_is_builtin_type_name(source, token) {
                continue
            }
            // A member or method declaration. Member uses are written
            // `x.name` and are never renamed, so this keeps its spelling.
            priv_span_add(shadows, token.start, token.end)
            expect_value_name = false
            expect_name = false
            pending_export = false
            continue
        }

        if token.kind == PRIV_IDENT {
            if depth == 0 && priv_token_is(source, token, "export") {
                priv_span_add(exports, token.start, token.end)
                pending_export = true
                expect_name = false
                continue
            }
            if depth == 0 && priv_is_declaration_keyword(source, token) {
                expect_name = true
                continue
            }
            if depth == 1 && priv_is_type_keyword(source, token) {
                expect_value_name = true
                expect_name = false
                pending_export = false
                continue
            }
            if depth == 1 && priv_token_is(source, token, "func") {
                // Method declaration: calls are written `x.name()`.
                expect_value_name = true
                expect_name = false
                pending_export = false
                continue
            }
            if depth == 1 && (priv_token_is(source, token, "var") || priv_token_is(source, token, "const")) {
                expect_value_name = true
                expect_name = false
                pending_export = false
                continue
            }
            if expect_name {
                if priv_is_builtin_type_name(source, token) {
                    continue
                }
                if !pending_export {
                    priv_span_add(privates, token.start, token.end)
                }
                expect_name = false
                pending_export = false
                continue
            }
            pending_export = false
            continue
        }

        // Punctuation.
        char punct = str_char_at(source, token.start)
        if punct == '{' {
            depth = depth + 1
        } else if punct == '}' && depth > 0 {
            depth = depth - 1
        }
        expect_name = false
        expect_value_name = false
        pending_export = false
    }
}

// True when the text contains a top-level `import "./file.cn"` declaration.
func priv_has_local_import(str source): bool {
    if source == null {
        return false
    }
    int length = len(source)
    int i = 0
    while i < length {
        PrivTok token = new PrivTok(0, 0, 0)
        int end = priv_scan(source, i, length, token)
        i = end
        if token.kind != PRIV_IDENT || !priv_token_is(source, token, "import") {
            continue
        }
        int j = token.end
        while j < length && (str_char_at(source, j) == ' ' || str_char_at(source, j) == '\t') {
            j = j + 1
        }
        if j < length && str_char_at(source, j) == '"' {
            return true
        }
    }
    return false
}

// `tag` below zero only strips `export`; otherwise non-exported top-level names
// get `__m<tag>` appended wherever they appear (except member/attribute uses
// and member declarations).
func priv_module_source(str source, int tag): str {
    if source == null {
        return ""
    }
    int length = len(source)
    PrivSpans exports = new PrivSpans()
    PrivSpans privates = new PrivSpans()
    PrivSpans shadows = new PrivSpans()
    priv_scan_declarations(source, exports, privates, shadows)

    if exports.count == 0 && (tag < 0 || privates.count == 0) {
        return source
    }

    str out = ""
    int i = 0
    while i < length {
        PrivTok token = new PrivTok(0, 0, 0)
        int end = priv_scan(source, i, length, token)
        int gap = token.start - i
        if gap > 0 {
            out = out + str_substring(source, i, token.start)
        }

        if token.kind == PRIV_IDENT && priv_span_contains(exports, token.start, token.end) {
            // `export` becomes whitespace so every later column stays put.
            out = out + str_repeat(" ", token.end - token.start)
        } else if token.kind == PRIV_IDENT && tag >= 0 &&
                  !priv_is_member_or_attribute_name(source, token.start) &&
                  priv_span_has_name(source, token, privates) &&
                  !priv_span_contains(shadows, token.start, token.end) {
            out = out + str_substring(source, token.start, token.end) + "__m" + to_str(tag)
        } else if end > token.start {
            out = out + str_substring(source, token.start, end)
        }
        i = end
    }
    return out
}
