// The reader matching a typed destination for a context-sensitive input().
func input_reader_for_type(int ttype): str {
    if ttype == TOKEN_INT_TYPE { return "cnext_input_int" }
    if ttype == TOKEN_UINT_TYPE { return "cnext_input_uint" }
    if ttype == TOKEN_LONG_TYPE { return "cnext_input_long" }
    if ttype == TOKEN_ULONG_TYPE { return "cnext_input_ulong" }
    if ttype == TOKEN_FLOAT_TYPE { return "cnext_input_float" }
    if ttype == TOKEN_DOUBLE_TYPE { return "cnext_input_double" }
    if ttype == TOKEN_BOOL_TYPE { return "cnext_input_bool" }
    if ttype == TOKEN_CHAR_TYPE { return "cnext_input_char" }
    if ttype == TOKEN_BYTE_TYPE { return "cnext_input_byte" }
    if ttype == TOKEN_USHORT_TYPE { return "cnext_input_ushort" }
    if ttype == TOKEN_UBYTE_TYPE { return "cnext_input_ubyte" }
    return "cnext_input"
}

// `input_int()` and friends name their own type, so they need no destination
// context. Empty for identifiers that are not explicit readers.
func explicit_input_reader(str name): str {
    if name == "input_int" { return "cnext_input_int" }
    if name == "input_uint" { return "cnext_input_uint" }
    if name == "input_long" { return "cnext_input_long" }
    if name == "input_ulong" { return "cnext_input_ulong" }
    if name == "input_float" { return "cnext_input_float" }
    if name == "input_double" { return "cnext_input_double" }
    if name == "input_bool" { return "cnext_input_bool" }
    if name == "input_char" { return "cnext_input_char" }
    if name == "input_byte" { return "cnext_input_byte" }
    if name == "input_ushort" { return "cnext_input_ushort" }
    if name == "input_ubyte" { return "cnext_input_ubyte" }
    if name == "input_str" { return "cnext_input" }
    return ""
}

func is_string_equality(ASTNode? node): bool {
    if node == null { return false }
    if node.token.kind == TOKEN_EQ_EQ {
        if node.left == null { return false }
        if node.right == null { return false }
        if node.left.expr_type == TOKEN_STR_TYPE { return true }
        if node.right.expr_type == TOKEN_STR_TYPE { return true }
    } else if node.token.kind == TOKEN_BANG_EQ {
        if node.left == null { return false }
        if node.right == null { return false }
        if node.left.expr_type == TOKEN_STR_TYPE { return true }
        if node.right.expr_type == TOKEN_STR_TYPE { return true }
    }
    return false
}

func is_string_ordering(ASTNode? node): bool {
    if node == null { return false }
    if node.left == null || node.right == null { return false }
    if node.left.expr_type != TOKEN_STR_TYPE &&
       node.right.expr_type != TOKEN_STR_TYPE {
        return false
    }
    return node.token.kind == TOKEN_LESS ||
           node.token.kind == TOKEN_LESS_EQ ||
           node.token.kind == TOKEN_GREATER ||
           node.token.kind == TOKEN_GREATER_EQ
}

func string_ordering_c_name(int op): str {
    if op == TOKEN_LESS { return "cnext_str_lt" }
    if op == TOKEN_LESS_EQ { return "cnext_str_le" }
    if op == TOKEN_GREATER { return "cnext_str_gt" }
    if op == TOKEN_GREATER_EQ { return "cnext_str_ge" }
    return ""
}

func binop_precedence(int op): int {
    if op == TOKEN_STAR || op == TOKEN_SLASH || op == TOKEN_PERCENT {
        return 5
    }
    if op == TOKEN_PLUS || op == TOKEN_MINUS {
        return 4
    }
    if op == TOKEN_LESS || op == TOKEN_LESS_EQ ||
       op == TOKEN_GREATER || op == TOKEN_GREATER_EQ {
        return 3
    }
    if op == TOKEN_EQ_EQ || op == TOKEN_BANG_EQ { return 2 }
    if op == TOKEN_AND_AND { return 1 }
    if op == TOKEN_OR_OR { return 0 }
    return -1
}

func needs_parens(int parent_op, int child_op, bool is_right): bool {
    int pp = binop_precedence(parent_op)
    int cp = binop_precedence(child_op)
    if cp < 0 { return false }
    if cp < pp { return true }
    if cp == pp && is_right { return true }
    return false
}

func gen_with_parens(ASTNode? child, int parent_op, bool is_right) {
    if child != null && child.kind == AST_BINARY &&
       needs_parens(parent_op, child.token.kind, is_right) {
        codegen_emit("(")
        generate_expression(child)
        codegen_emit(")")
    } else {
        generate_expression(child)
    }
}

// An array whose element type is a class stores class instances, which are
// pointers, so it uses CnextArrayObj rather than a typed value array.
func node_array_is_object(ASTNode? node): bool {
    if node == null { return false }
    if !node.is_array { return false }
    if node.var_type.kind == TOKEN_IDENTIFIER {
        var subst = find_type_subst(node.var_type.text)
        if subst != null {
            return subst.concrete_type.kind == TOKEN_IDENTIFIER
        }
        return true
    }
    return false
}

// `arr = { ... }` assigns a whole array value, so it needs a compound literal
// of the array struct. A bare braced list is not an expression in C.
func is_array_literal_assignment(ASTNode? node): bool {
    if node == null { return false }
    if node.right == null { return false }
    return node.right.kind == AST_LITERAL_ARRAY && node.right.is_array
}

// Emits `arr[i] = value` for an array of class instances, returning true when
// it handled the whole assignment.
func emit_object_array_element_assignment(ASTNode? node): bool {
    if node == null { return false }
    ASTNode? target = node.left
    if target == null { return false }
    if target.kind != AST_INDEX || !target.is_class { return false }
    if node.right == null { return false }
    if node.right.kind == AST_LITERAL_ARRAY || node.right.kind == AST_SLICE {
        return false
    }
    codegen_emit("CNEXT_ARRAY_IDX_OBJ_ASSIGN(")
    generate_expression(target.left)
    codegen_emit(", ")
    generate_expression(target.right)
    codegen_emit(", ")
    generate_expression(node.right)
    codegen_emit(")")
    return true
}

// Emits a whole array value from a literal. type_owner supplies the element
// type (it is the array declaration, or the annotated literal for an
// assignment). The backing store is heap allocated so the array can be grown
// later by push.
func generate_array_value(ASTNode? type_owner, ASTNode? literal) {
    codegen_emit("({ ")
    generate_node_type(type_owner, false)
    codegen_emit(" _cnarr = { (")
    if node_array_is_object(type_owner) {
        codegen_emit("void*")
    } else {
        generate_type(type_owner.var_type, false)
    }
    codegen_emit("[])")
    generate_expression(literal)
    codegen_emit(", ")
    codegen_emit(to_str(len(literal.children)))
    codegen_emit(" }; ")
    if node_array_is_object(type_owner) {
        codegen_emit("_cnarr.data = (void**)_cnext_array_heap_copy(_cnarr.data, _cnarr.length, sizeof(void*)); ")
    } else {
        codegen_emit("_cnarr.data = (")
        generate_type(type_owner.var_type, false)
        codegen_emit("*)_cnext_array_heap_copy(_cnarr.data, _cnarr.length, sizeof(")
        generate_type(type_owner.var_type, false)
        codegen_emit(")); ")
    }
    codegen_emit("_cnarr; })")
}

func member_uses_pointer(ASTNode? node): bool {
    if node == null { return false }
    if node.is_pointer_access { return true }
    if node.left == null { return false }    // Arrays are values even when their element type is a class.    if node.left.is_array { return false }
    if node.left.is_pointer { return true }
    // Semantics marks a value whose type is a class (a pointer in generated C)
    // and a field that itself holds a class reference.
    if node.left.is_class { return true }
    if node.left.kind == AST_IDENTIFIER && codegen_is_pointer_param(node.left.token.text) { return true }
    if node.left.kind == AST_IDENTIFIER {
        str member_type = node.left.type_name
        if len(member_type) == 0 { member_type = node.left.var_type.text }
        if codegen_is_class_name(member_type) { return true }
    }
    if node.left.kind == AST_MEMBER_ACCESS &&
       len(codegen_pointer_member_type(node.left)) > 0 {
        return true
    }
    if node.left.kind == AST_IDENTIFIER &&
       len(lookup_class_var(node.left.token.text)) > 0 {
        return true
    }
    if node.left.kind == AST_IDENTIFIER && node.left.token.text == "self" {
        return true
    }
    if node.left.kind == AST_MEMBER_ACCESS && node.left.is_class &&
       codegen_is_class_name(node.left.var_type.text) {
        return true
    }
    if node.left.kind == AST_INDEX {
        if node.left.var_type.kind == TOKEN_IDENTIFIER {
            return true
        }
    }
    return false
}

func typeof_type_name(ASTNode? inner): str {
    if inner == null { return "unknown" }
    if inner.expr_type == TOKEN_INT_TYPE { return "int" }
    if inner.expr_type == TOKEN_LONG_TYPE { return "long" }
    if inner.expr_type == TOKEN_FLOAT_TYPE { return "float" }
    if inner.expr_type == TOKEN_DOUBLE_TYPE { return "double" }
    if inner.expr_type == TOKEN_STR_TYPE { return "str" }
    if inner.expr_type == TOKEN_BOOL_TYPE { return "bool" }
    if inner.expr_type == TOKEN_CHAR_TYPE { return "char" }
    if inner.expr_type == TOKEN_BYTE_TYPE { return "byte" }
    if inner.expr_type == TOKEN_UINT_TYPE { return "uint" }
    if inner.expr_type == TOKEN_ULONG_TYPE { return "ulong" }
    if inner.expr_type == TOKEN_USHORT_TYPE { return "ushort" }
    if inner.expr_type == TOKEN_UBYTE_TYPE { return "ubyte" }
    return "unknown"
}

func extension_prefix(int kind): str {
    if kind == TOKEN_STR_TYPE { return "str" }
    if kind == TOKEN_INT_TYPE { return "int" }
    if kind == TOKEN_LONG_TYPE { return "long" }
    if kind == TOKEN_FLOAT_TYPE { return "float" }
    if kind == TOKEN_DOUBLE_TYPE { return "double" }
    if kind == TOKEN_BOOL_TYPE { return "bool" }
    if kind == TOKEN_CHAR_TYPE { return "char" }
    return ""
}

func emit_variant_value(ASTNode? node, str var_name, str tag): bool {
    codegen_emit("({ CnextVariant ")
    codegen_emit(var_name)
    codegen_emit(" = ")
    codegen_emit("{")
    codegen_emit(tag)
    codegen_emit(", 0, ")
    codegen_emit("{")
    codegen_emit("0")
    codegen_emit("}")
    codegen_emit("}")
    codegen_emit("; __typeof__(")
    generate_expression(node.left)
    codegen_emit(") _val = (")
    generate_expression(node.left)
    codegen_emit("); memcpy(")
    codegen_emit(var_name)
    codegen_emit(".payload, &_val, sizeof(_val)); ")
    codegen_emit(var_name)
    codegen_emit(".size = sizeof(_val); ")
    codegen_emit(var_name)
    codegen_emit("; })")
    return true
}

func when_has_else(ASTNode node): bool {
    int i = 0
    while i < len(node.children) {
        ASTNode? arm = node.children[i]
        if arm != null && arm.is_const { return true }
        i = i + 1
    }
    return false
}

func emit_when_arm_chain(ASTNode node, int index) {
    if index >= len(node.children) {
        codegen_emit("0")
        return
    }
    ASTNode? arm = node.children[index]
    if arm == null {
        emit_when_arm_chain(node, index + 1)
        return
    }
    if arm.is_const || ((arm.condition == null) && (arm.left != null)) {
        codegen_emit("(")
        if arm.left != null { generate_expression(arm.left) } else { codegen_emit("0") }
        codegen_emit(")")
        return
    }
    if arm.condition == null || arm.left == null {
        emit_when_arm_chain(node, index + 1)
        return
    }
    codegen_emit("(")
    generate_expression(arm.condition)
    codegen_emit(") ? (")
    generate_expression(arm.left)
    codegen_emit(") : ")
    if index + 1 == len(node.children) && !when_has_else(node) {
        codegen_emit("(")
        generate_expression(arm.left)
        codegen_emit(")")
        return
    }
    emit_when_arm_chain(node, index + 1)
}

func generate_expression(ASTNode? node): bool {
    if node == null {
        return false
    }
    if node.kind == AST_CALL && emit_managed_closure_arguments(node) { return true }    if node.kind == AST_LAMBDA {        emit_lambda(node)
        return true
    }

    if node.kind == AST_LITERAL {

        if node.token.kind == TOKEN_STRING_LITERAL {
            generate_string_interpolation(node.token.text, len(node.token.text))
            return true
        } else if node.token.kind == TOKEN_NUMBER {
            codegen_emit(node.token.text)
            return true
        } else if node.token.kind == TOKEN_FLOAT_LITERAL {
            codegen_emit(node.token.text)
            return true
        } else if node.token.kind == TOKEN_TRUE {
            codegen_emit("true")
            return true
        } else if node.token.kind == TOKEN_FALSE {
            codegen_emit("false")
            return true
        } else if node.token.kind == TOKEN_NULL {
            codegen_emit("NULL")
            return true
        }
        codegen_emit(node.token.text)
        return true
    } else if node.kind == AST_NULL_LITERAL {
        if node.expr_type == TOKEN_STR_TYPE {
            codegen_emit("(CnextString)")
            codegen_emit("{")
            codegen_emit("NULL, 0}")
        } else {
            codegen_emit("NULL")
        }
        return true
    } else if node.kind == AST_OPTION_NONE {
        codegen_emit("((CnextVariant)")
        codegen_emit("{")
        codegen_emit("0, 0, ")
        codegen_emit("{")
        codegen_emit("0}")
        codegen_emit("})")
        return true
    } else if node.kind == AST_OPTION_SOME {
