    } else if node.kind == AST_POSTFIX {
        generate_expression(node.left)
        codegen_emit(node.token.text)
        return true
    } else if node.kind == AST_TUPLE_ACCESS {
        generate_expression(node.left)
        codegen_emit("._")
        codegen_emit(node.token.text)
        return true
    } else if node.kind == AST_LITERAL_ARRAY {
        codegen_emit("{")
        int i = 0
        int n = len(node.children)
        while i < n {
            if i > 0 { codegen_emit(", ") }
            generate_expression(node.children[i])
            i = i + 1
        }
        codegen_emit("}")
        return true
    } else if node.kind == AST_TUPLE {
        codegen_emit("({ CnextString _tr = (CnextString){(char*)\"(\", 1}; ")
        int i = 0
        int n = len(node.children)
        while i < n {
            if i > 0 {
                codegen_emit("_tr = cnext_concat(_tr, (CnextString){(char*)\", \", 2}); ")
            }
            codegen_emit("_tr = cnext_concat(_tr, cnext_to_string(")
            generate_expression(node.children[i])
            codegen_emit(")); ")
            i = i + 1
        }
        codegen_emit("_tr = cnext_concat(_tr, (CnextString){(char*)\")\", 1}); ")
        codegen_emit("(CnextTuple)")
        codegen_emit("{")
        codegen_emit(to_str(n))
        codegen_emit(", _tr}; })")
        return true
    } else if node.kind == AST_BLOCK {
        codegen_emit("{\n")
        int i = 0
        int n = len(node.children)
        while i < n {
            generate_statement(node.children[i])
            i = i + 1
        }
        codegen_emit("}")
        return true
    } else if node.kind == AST_ASSIGN {        if node.left != null && node.left.expr_type == TOKEN_FUNC && node.token.kind == TOKEN_EQUAL {            codegen_emit("cnext_closure_assign(&(")            generate_expression(node.left)            codegen_emit("), ")            emit_owned_closure(node.right)            codegen_emit(")")            return true        }
        if emit_object_array_element_assignment(node) {
            return true
        }
        generate_expression(node.left)
        codegen_emit(" ")
        codegen_emit(node.token.text)
        codegen_emit(" ")
        if is_array_literal_assignment(node) {
            generate_array_value(node.right, node.right)
        } else if node.left != null && node.left.kind == AST_MEMBER_ACCESS &&
                  (node.left.token.text == "children" ||
                   node.left.token.text == "type_params" ||
                   node.left.token.text == "type_args") &&
                  node.right != null && node.right.kind == AST_LITERAL_ARRAY &&
                  len(node.right.children) == 0 {
            // src2 self-compile workaround: an empty object-array field
            // literal that semantics could not annotate.
            codegen_emit("(CnextArrayObj)")
            codegen_emit("{")
            codegen_emit("0")
            codegen_emit("}")
        } else {
            generate_expression(node.right)
        }
        return true
    } else if node.kind == AST_NULL_COALESCE {
        bool is_str = node.expr_type == TOKEN_STR_TYPE || node.type_name == "str"
        bool is_class = node.expr_type == TOKEN_IDENTIFIER && len(node.type_name) > 0 && node.type_name != "str"
        if is_str {
            codegen_emit("(((")
            generate_expression(node.left)
            codegen_emit(").data != NULL) ? (")
            generate_expression(node.left)
            codegen_emit(") : (")
            generate_expression(node.right)
            codegen_emit("))")
        } else if is_class {
            codegen_emit("(((")
            generate_expression(node.left)
            codegen_emit(") != NULL) ? (")
            generate_expression(node.left)
            codegen_emit(") : (")
            generate_expression(node.right)
            codegen_emit("))")
        } else {
            generate_expression(node.left)
        }
        return true
    } else if node.kind == AST_SAFE_ACCESS {
        str zero_val = "NULL"
        if node.expr_type == TOKEN_STR_TYPE || node.type_name == "str" { zero_val = "(CnextString)" + to_char(123) + "NULL, 0" + to_char(125) }
        else if node.expr_type == TOKEN_INT_TYPE { zero_val = "0" }
        else if node.expr_type == TOKEN_FLOAT_TYPE { zero_val = "0.0f" }
        else if node.expr_type == TOKEN_DOUBLE_TYPE { zero_val = "0.0" }
        else if node.expr_type == TOKEN_BOOL_TYPE { zero_val = "0" }
        codegen_emit("(((")
        generate_expression(node.left)
        codegen_emit(") != NULL) ? (")
        generate_expression(node.left)
        if member_uses_pointer(node) { codegen_emit("->") } else { codegen_emit(".") }
        codegen_emit(node.token.text)
        codegen_emit(") : (" + zero_val + "))")
        return true
    } else if node.kind == AST_TERNARY {
        codegen_emit("(")
        generate_expression(node.condition)
        codegen_emit(") ? (")
        generate_expression(node.left)
        codegen_emit(") : (")
        generate_expression(node.right)
        codegen_emit(")")
        return true
    } else if node.kind == AST_MEMBER_ACCESS {
        generate_expression(node.left)
        if member_uses_pointer(node) {
            codegen_emit("->")
        } else {
            codegen_emit(".")
        }
        codegen_emit(node.token.text)
        return true
    } else if node.kind == AST_AWAIT_EXPR {
        codegen_emit("({ __auto_type _af = (")
        if node.left != null { generate_expression(node.left) }
        codegen_emit("); while (_af->_next(_af)); _af->current; })")
        return true
    } else if node.kind == AST_WHEN {
        codegen_emit("(")
        emit_when_arm_chain(node, 0)
        codegen_emit(")")
        return true
    }
    
    if node.left != null {
        generate_expression(node.left)
    }
    return true
}

func generate_expression_stmt(ASTNode? node) {
    if node == null { return }
    if node.expr_type == TOKEN_FUNC &&       (node.kind == AST_CALL || node.kind == AST_LAMBDA || node.kind == AST_TERNARY) {        codegen_emit("{ CnextClosure _cnext_unused = ")        emit_owned_closure(node)        codegen_emit("; cnext_closure_decref(&_cnext_unused); }\n")        return    }    if node.kind == AST_TRY_EXPR {
        bool try_nullable = node.expr_type == TOKEN_STR_TYPE || node.expr_type == TOKEN_IDENTIFIER || node.expr_type == TOKEN_FUNC
        if !try_nullable {
            generate_expression(node)
            codegen_emit(";\n")
            return
        }
        int d = g_try_counter
        g_try_counter = g_try_counter + 1
        str id = to_str(d)
        codegen_emit("{\n")
        g_indent_level = g_indent_level + 1
        write_indent()
        codegen_emit("__auto_type _try_" + id + " = ")
        generate_expression(node)
        codegen_emit(";\n")
        write_indent()
        if node.expr_type == TOKEN_STR_TYPE {
            codegen_emit("if (_try_" + id + ".data == NULL) {\n")
        } else {
            codegen_emit("if (_try_" + id + " == NULL) {\n")
        }
        g_indent_level = g_indent_level + 1
        write_indent()
        codegen_emit("return;\n")
        g_indent_level = g_indent_level - 1
        write_indent()
        codegen_emit("}\n")
        g_indent_level = g_indent_level - 1
        write_indent()
        codegen_emit("}\n")
        return
    }
    generate_expression(node)
    codegen_emit(";\n")
}
