// Self-hosting bootstrap: codegen expression generation.
// Port of src/codegen_expr.c (simplified)

// Mirrors src/codegen_expr.c builtin_dispatch exactly. Call special forms
// (print/printin/input/push/...) are handled before this table is consulted.
func builtin_c_name(str name): str {
    if name == "str_upper" { return "cnext_str_to_upper" }
    if name == "str_lower" { return "cnext_str_to_lower" }
