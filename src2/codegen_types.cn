// Self-hosting bootstrap: codegen type helpers.
// Port of src/codegen_types.c

class TypeSubst {
    str param_name
    Token concrete_type
    bool is_array
    TypeSubst? next
    func new(str name, Token ttype, bool arr) {
        self.param_name = name
        self.concrete_type = ttype
        self.is_array = arr
        self.next = null
    }
}

class ClassVar {
    str var_name
    str class_name
    ClassVar? next
    func new(str vname, str cname) {
        self.var_name = vname
        self.class_name = cname
        self.next = null
    }
}

class GenSpec {
    str mangled_name
    Token return_type
    bool return_is_array
    GenSpec? next
    func new(str name, Token ret, bool ret_arr) {
        self.mangled_name = name
        self.return_type = ret
        self.return_is_array = ret_arr
        self.next = null
    }
}

// A struct (Token) cannot live in a Cnext array directly: arrays of class
// instances are object arrays and arrays of primitives need a matching runtime
// type. Box the token in a class so the generic work queue can hold a list.
class TokenBox {
    Token value

    func new(Token t) {
        self.value = t
    }
}

class SpecWork {
    ASTNode? func_decl
    str mangled_name
    TokenBox[] resolved_args
    bool[] resolved_is_array
    int resolved_count
    SpecWork? next
}

// Pending concrete instantiations of generic classes such as Box<int>.
class ClassSpecWork {
    ASTNode? class_decl
    str mangled_name
    TokenBox[] resolved_args
    bool[] resolved_is_array
    int resolved_count
    ClassSpecWork? next
}

TypeSubst? g_type_subst_map = null
ClassVar? g_class_vars = null
ClassVar? g_global_class_vars = null
GenSpec? g_gen_specs = null
SpecWork? g_spec_work_queue = null
SpecWork? g_spec_work_last = null
ClassSpecWork? g_class_spec_queue = null
ClassSpecWork? g_class_spec_last = null

func push_type_subst(str name, Token ttype, bool is_array) {
    var ts = new TypeSubst(name, ttype, is_array)
    ts.next = g_type_subst_map
    g_type_subst_map = ts
}

func pop_type_subst() {
    if g_type_subst_map != null {
        g_type_subst_map = g_type_subst_map.next
    }
}

func clear_type_subst() {
    while g_type_subst_map != null {
        g_type_subst_map = g_type_subst_map.next
    }
}

func find_type_subst(str name): TypeSubst? {
    var ts = g_type_subst_map
    while ts != null {
        if ts.param_name == name {
            return ts
        }
        ts = ts.next
    }
    return null
}

func track_class_var(str var_name, str class_name) {
    var cv = new ClassVar(var_name, class_name)
    cv.next = g_class_vars
    g_class_vars = cv
}

func lookup_class_var(str var_name): str {
    var cv = g_class_vars
    while cv != null {
        if cv.var_name == var_name {
            return cv.class_name
        }
        cv = cv.next
    }
    cv = g_global_class_vars
    while cv != null {
        if cv.var_name == var_name {
            return cv.class_name
        }
        cv = cv.next
    }
    return ""
}

func codegen_pointer_member_type(ASTNode? member): str {
    if member == null || member.kind != AST_MEMBER_ACCESS ||
       member.left == null ||
       member.left.var_type.kind != TOKEN_IDENTIFIER {
        return ""
    }
    str owner = member.left.var_type.text
    if owner == "ASTNode" {
        if member.token.text == "left" ||
           member.token.text == "right" ||
           member.token.text == "condition" ||
           member.token.text == "init" ||
           member.token.text == "increment" ||
           member.token.text == "default_value" {
            return "ASTNode"
        }
    }
    if owner == "Scope" {
        if member.token.text == "symbols" { return "Symbol" }
        if member.token.text == "parent" { return "Scope" }
    }
    if owner == "Symbol" {
        if member.token.text == "next" { return "Symbol" }
        if member.token.text == "node" { return "ASTNode" }
    }
    if owner == "ClassVar" && member.token.text == "next" {
        return "ClassVar"
    }
    return ""
}

func has_gen_spec(str name): bool {
    var gs = g_gen_specs
    while gs != null {
        if gs.mangled_name == name {
            return true
        }
        gs = gs.next
    }
    return false
}

func add_gen_spec(str name, Token ret_type, bool ret_is_array) {
    var gs = new GenSpec(name, ret_type, ret_is_array)
    gs.next = g_gen_specs
    g_gen_specs = gs
}

func free_gen_specs() {
    g_gen_specs = null
}
