{
  "name": "cnext",
  "displayName": "Cnext Language Support",
  "description": "Full language support for Cnext: syntax highlighting, IntelliSense (LSP), diagnostics, snippets, formatting, and build tasks",
  "version": "10.0.3",
  "publisher": "MellyTech122",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "cnext",
    "language",
    "transpiler",
    "compiler",
    "programming language",
    "lsp"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cnext"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cnext",
        "aliases": [
          "Cnext",
          "cnext"
        ],
        "extensions": [
          ".cn"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cnext",
        "scopeName": "source.cnext",
        "path": "./syntaxes/cnext.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cnext",
        "path": "./snippets/cnext.json"
      }
    ],
    "iconThemes": [
      {
        "id": "cnext",
        "label": "Cnext",
        "path": "./icon-themes/cnext-icon-theme.json"
      }
    ],
    "commands": [
      {
        "command": "cnext.run",
        "title": "Cnext: Run File",
        "icon": "$(play)"
      },
      {
        "command": "cnext.build",
        "title": "Cnext: Build File",
        "icon": "$(tools)"
      },
      {
        "command": "cnext.buildRelease",
        "title": "Cnext: Build Release",
        "icon": "$(package)"
      },
      {
        "command": "cnext.test",
        "title": "Cnext: Run Tests",
        "icon": "$(beaker)"
      },
      {
        "command": "cnext.format",
        "title": "Cnext: Format File",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "cnext.lint",
        "title": "Cnext: Lint File",
        "icon": "$(alert)"
      },
      {
        "command": "cnext.newProject",
        "title": "Cnext: New Project",
        "icon": "$(add)"
      },
      {
        "command": "cnext.doctor",
        "title": "Cnext: Doctor (Check Environment)",
        "icon": "$(pulse)"
      },
      {
        "command": "cnext.repl",
        "title": "Cnext: Start REPL",
        "icon": "$(terminal)"
      },
      {
        "command": "cnext.restartLanguageServer",
        "title": "Cnext: Restart Language Server",
        "icon": "$(debug-restart)"
      },
      {
        "command": "cnext.showLspLog",
        "title": "Cnext: Show LSP Log",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cnext.run",
          "when": "editorLangId == cnext",
          "group": "cnext@1"
        },
        {
          "command": "cnext.build",
          "when": "editorLangId == cnext",
          "group": "cnext@2"
        },
        {
          "command": "cnext.buildRelease",
          "when": "editorLangId == cnext",
          "group": "cnext@2"
        },
        {
          "command": "cnext.lint",
          "when": "editorLangId == cnext",
          "group": "cnext@3"
        },
        {
          "command": "cnext.format",
          "when": "editorLangId == cnext",
          "group": "cnext@3"
        },
        {
          "command": "cnext.repl",
          "when": "editorLangId == cnext",
          "group": "cnext@3"
        }
      ],
      "editor/title/context": [
        {
          "command": "cnext.run",
          "when": "resourceLangId == cnext",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "cnext.run",
          "when": "editorLangId == cnext"
        },
        {
          "command": "cnext.build",
          "when": "editorLangId == cnext"
        },
        {
          "command": "cnext.format",
          "when": "editorLangId == cnext"
        },
        {
          "command": "cnext.test",
          "when": "editorLangId == cnext"
        }
      ]
    },
    "keybindings": [
      {
        "command": "cnext.run",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorLangId == cnext"
      },
      {
        "command": "cnext.build",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorLangId == cnext"
      },
      {
        "command": "cnext.test",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorLangId == cnext"
      },
      {
        "command": "cnext.format",
        "key": "shift+alt+f",
        "mac": "shift+cmd+f",
        "when": "editorLangId == cnext"
      }
    ],
    "taskDefinitions": [
      {
        "type": "cnext",
        "properties": {
          "command": {
            "type": "string",
            "description": "Cnext command to run"
          },
          "file": {
            "type": "string",
            "description": "File to process"
          }
        },
        "required": [
          "command"
        ]
      }
    ],
    "configuration": {
      "title": "Cnext",
      "properties": {
        "cnext.compilerPath": {
          "type": "string",
          "default": "cnext",
          "description": "Path to the Cnext compiler"
        },
        "cnext.autoRun": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run file after save"
        },
        "cnext.autoFormat": {
          "type": "boolean",
          "default": false,
          "description": "Automatically format file after save"
        },
        "cnext.lsp.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Cnext language server (completion, hover, go-to-definition, diagnostics, formatting)"
        },
        "cnext.lsp.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python interpreter used to run the language server (defaults to python/python3/py on PATH)"
        },
        "cnext.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the language server script (defaults to the bundled lsp/server.py)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "echo 'No build step needed'"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Melton122/cnext"
  },
  "bugs": {
    "url": "https://github.com/Melton122/cnext/issues"
  },
  "homepage": "https://github.com/Melton122/cnext#readme"
}
