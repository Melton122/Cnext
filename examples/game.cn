// Simple Text Adventure Game

class Fighter {
    str name
    int health
    int attack_power

    func new(str n, int h, int ap) {
        self.name = n
        self.health = h
        self.attack_power = ap
    }

    func attack(Fighter enemy): int {
        var damage = self.attack_power
        enemy.health = enemy.health - damage
        return damage
    }

    func is_alive(): bool {
        return self.health > 0
    }

    func info(): str {
        return self.name + " (HP: " + to_str(self.health) + ")"
    }
}

class Player extends Fighter {
    func new(str n, int h, int ap) {
        super.new(n, h, ap)
    }
}

class Monster extends Fighter {
    func new(str n, int h, int ap) {
        super.new(n, h, ap)
    }
}

func battle(Fighter hero, Fighter monster) {
    printin("Battle: " + hero.info() + " vs " + monster.name)

    while hero.is_alive() && monster.is_alive() {
        var damage = hero.attack(monster)
        printin(hero.name + " attacks for " + to_str(damage) + " damage!")

        if !monster.is_alive() {
            printin(monster.name + " is defeated!")
            break
        }

        damage = monster.attack(hero)
        printin(monster.name + " attacks for " + to_str(damage) + " damage!")

        if !hero.is_alive() {
            printin(hero.name + " has fallen!")
            break
        }
    }
}

main {
    Fighter hero = new Player("Hero", 100, 20)
    Fighter goblin = new Monster("Goblin", 50, 10)
    Fighter dragon = new Monster("Dragon", 200, 30)

    battle(hero, goblin)

    if hero.is_alive() {
        printin("\nHero is victorious! Preparing for dragon...")
        hero.health = 100
        battle(hero, dragon)
    }
}
