// EXPECT: Hello from Cnext IO!
// EXPECT: true
// EXPECT: Hello from Cnext IO!
// EXPECT: Appended line.
import io

main {
    str content = "Hello from Cnext IO!"
    write_file("test_output.txt", content)

    str read_back = read_file("test_output.txt")
    printin(read_back)

    bool exists = file_exists("test_output.txt")
    printin(exists)

    append_file("test_output.txt", "\nAppended line.")

    str read_again = read_file("test_output.txt")
    printin(read_again)
}
