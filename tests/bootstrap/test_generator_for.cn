func counted(int n): iter<int> {
    for int i = 0; i < n; i++ {
        {
            int offset = i + 10
            yield i
            yield offset
        }
    }
}

func reassigned(int n): iter<int> {
    int i = 0
    for i = 1; i <= n; i = i + 1 {
        yield i
    }
}

main {
    for value in counted(3) {
        printin(value)
    }
    for value in reassigned(2) {
        printin(value)
    }
}
