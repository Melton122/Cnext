// Test: Comprehensive Built-in Functions Test
// Tests all categories of built-in functions together

main {
    printin("=== String Functions ===")
    str upper = str_upper("hello")
    str lower = str_lower("HELLO")
    str cap = str_capitalize("hello")
    str title = str_title("hello world")
    str trimmed = str_trim("  hi  ")
    bool has = str_contains("hello", "ell")
    bool starts = str_starts_with("hello", "he")
    bool ends = str_ends_with("hello", "lo")
    int idx = str_index_of("hello", "ll")
    int last = str_last_index_of("aab", "a")
    str rep = str_repeat("ab", 3)
    str rev = str_reverse("hello")
    str padl = str_pad_left("42", 5, '0')
    str padr = str_pad_right("hi", 5, '.')
    str rem = str_remove("hello", "l")
    str ins = str_insert("hello", 2, "XX")
    printin(upper)
    printin(lower)
    printin(cap)
    printin(title)
    printin(trimmed)
    printin(has)
    printin(starts)
    printin(ends)
    printin(idx)
    printin(last)
    printin(rep)
    printin(rev)
    printin(padl)
    printin(padr)
    printin(rem)
    printin(ins)

    printin("=== Math Functions ===")
    int a = math_abs(-5)
    int m = math_min(5, 3)
    int M = math_max(5, 3)
    int c = math_clamp(10, 0, 5)
    int g = math_gcd(12, 8)
    int l = math_lcm(4, 6)
    long fact = math_factorial(5)
    int fib = math_fibonacci(10)
    printin(a)
    printin(m)
    printin(M)
    printin(c)
    printin(g)
    printin(l)
    printin(fact)
    printin(fib)

    printin("=== Type Conversion ===")
    int n = to_int(3.14)
    float f = to_float(42)
    bool b = to_bool(1)
    str s = to_str(42)
    int code = ord("A")
    printin(n)
    printin(f)
    printin(b)
    printin(s)
    printin(code)

    printin("=== Core Functions ===")
    int length = len("hello")
    str type_name = typeof(42)
    printin(length)
    printin(type_name)

    printin("=== File Functions ===")
    write_file("_test_comp.txt", "test content")
    str file_content = read_file("_test_comp.txt")
    bool file_exists_val = file_exists("_test_comp.txt")
    long file_size_val = file_size("_test_comp.txt")
    printin(file_content)
    printin(file_exists_val)
    printin(file_size_val)
    delete_file("_test_comp.txt")

    printin("=== System Functions ===")
    str os = platform()
    str temp = temp_dir()
    str home = home_dir()
    int cpus = cpu_count()
    printin(os)
    printin(temp)
    printin(home)
    printin(cpus)

    printin("=== Encoding/Crypto ===")
    str encoded = base64_encode("hello")
    str decoded = base64_decode(encoded)
    str hash = md5("hello")
    str id = uuid()
    printin(encoded)
    printin(decoded)
    printin(hash)
    printin(id)

    printin("=== All comprehensive tests passed! ===")
}
